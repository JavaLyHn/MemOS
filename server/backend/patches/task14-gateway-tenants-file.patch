+#!/usr/bin/env python3
+"""Task 14 RED：网关侧 tenants.conf（dashboard 合成下发）的读取与合并。
+
+不依赖 fastmcp、不起服务。跑法：
+
+    python test_gateway_tenants_file.py
+"""
+
+from __future__ import annotations
+
+import pathlib
+import tempfile
+import unittest
+
+from gateway.domain.tenants import load_tenants_file, merge_tenants, parse_tenants
+
+
+class LoadTenantsFile(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.dir = pathlib.Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def write(self, text, name="tenants.conf"):
+        path = self.dir / name
+        path.write_text(text, encoding="utf-8")
+        return path
+
+    def test_missing_file_is_empty(self):
+        self.assertEqual(load_tenants_file(self.dir / "absent.conf"), {})
+
+    def test_file_json_same_shape_as_env(self):
+        path = self.write('{"tok-a": {"user_id": "a", "cube_id": "c"}, "tok-b": "b"}')
+        parsed = load_tenants_file(path)
+        self.assertEqual(parsed["tok-a"].user_id, "a")
+        self.assertEqual(parsed["tok-a"].cube_id, "c")
+        self.assertEqual(parsed["tok-b"].user_id, "b")
+        self.assertEqual(parsed["tok-b"].cube_id, "b")
+
+    def test_bad_json_raises_valueerror(self):
+        path = self.write("{not json")
+        with self.assertRaises(ValueError):
+            load_tenants_file(path)
+
+    def test_merge_disjoint_sources(self):
+        base = parse_tenants("env-tok:alice")
+        path = self.write('{"file-tok": {"user_id": "bob", "cube_id": "bob"}}')
+        merged = merge_tenants(base, load_tenants_file(path), extra_source="tenants.conf")
+        self.assertEqual(merged["env-tok"].user_id, "alice")
+        self.assertEqual(merged["file-tok"].user_id, "bob")
+        self.assertEqual(len(merged), 2)
+
+    def test_merge_conflict_names_both_sources_without_token_plaintext(self):
+        base = parse_tenants("same-tok:alice")
+        path = self.write('{"same-tok": {"user_id": "mallory", "cube_id": "mallory"}}')
+        with self.assertRaises(ValueError) as caught:
+            merge_tenants(base, load_tenants_file(path), extra_source="tenants.conf")
+        message = str(caught.exception)
+        self.assertIn("MEMOS_TENANTS", message)
+        self.assertIn("tenants.conf", message)
+        self.assertNotIn("same-tok", message)
+
+    def test_merge_identical_entry_dedupes(self):
+        base = parse_tenants("same-tok:alice")
+        path = self.write('{"same-tok": {"user_id": "alice", "cube_id": "alice"}}')
+        merged = merge_tenants(base, load_tenants_file(path), extra_source="tenants.conf")
+        self.assertEqual(len(merged), 1)
+        self.assertEqual(merged["same-tok"].user_id, "alice")
+
+    def test_invalid_config_never_exposes_token(self):
+        token = "sk-" + "x" * 48
+        for raw in ('{"' + token + '":{}}', token, '{"' + token + '":[1]}'):
+            try:
+                parse_tenants(raw)
+            except ValueError as error:
+                self.assertFalse(token in str(error))
+            else:
+                self.fail("Malformed credential configuration was accepted")
+
+    def test_pending_manifest_is_rejected(self):
+        path = self.write("{}")
+        path.with_name(path.name + ".pending").write_text("pending")
+        with self.assertRaises(ValueError):
+            load_tenants_file(path)
+
+    def test_reader_waits_for_publication_lock(self):
+        import threading
+
+        from gateway.domain.tenants import _manifest_lock
+
+        path = self.write("{}")
+        started, done = threading.Event(), threading.Event()
+        failures = []
+
+        def read():
+            started.set()
+            try:
+                load_tenants_file(path)
+            except Exception as error:
+                failures.append(type(error).__name__)
+            finally:
+                done.set()
+
+        with _manifest_lock(path):
+            reader = threading.Thread(target=read)
+            reader.start()
+            self.assertTrue(started.wait(2))
+            self.assertFalse(done.wait(0.1))
+        reader.join(4)
+        self.assertTrue(done.is_set())
+        self.assertEqual(failures, [])
+
+    def test_legacy_null_cube_still_defaults_to_user(self):
+        parsed = parse_tenants('{"legacy": {"user_id":"a", "cube_id":null}}')
+        self.assertEqual(parsed["legacy"].cube_id, "a")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
