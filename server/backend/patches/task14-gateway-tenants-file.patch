+@pytest.mark.parametrize("failure", ["invalid", "pending", "missing", "conflict"])
+def test_bad_publication_fails_closed_and_recovers(tmp_path, failure):
+    path = tmp_path / "tenants.conf"
+    publish(path, {"first": "alice"})
+    tenants = registry(path)
+    if failure == "invalid":
+        path.write_text('{"credential-secret":', encoding="utf-8")
+    elif failure == "pending":
+        path.with_name(path.name + ".pending").write_text("pending")
+    elif failure == "missing":
+        path.unlink()
+    else:
+        publish(path, {"env-token": "mallory"})
+    assert tenants.authenticate("first") is None
+    assert tenants.authenticate("credential-secret") is None
+    assert tenants.authenticate("env-token").user_id == "operator"
+    path.with_name(path.name + ".pending").unlink(missing_ok=True)
+    publish(path, {"second": "bob"})
+    assert tenants.authenticate("second").user_id == "bob"
+    assert tenants.authenticate("first") is None
+
