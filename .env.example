# 控制台后端 origin。
#   留空 = 同源，走 /api。开发态由 vite.config.ts 把 /api 代理到 mock 后端（pnpm mock）。
#   接真后端时改这里指向对方，前端代码一行不用动。
VITE_API_BASE=

# 记忆服务地址，用于落地页/文档/快速开始里展示的接入信息。
# 默认 http://localhost:8003
VITE_SERVICE_BASE=

# 模型清单的静态目录。模型列表不走后端接口，而是取这里的 JSON（`{records: [...]}`）。
# 默认 /tech-config，读 public/tech-config/ 下的文件。
VITE_TECH_CONFIG_URL=

# mock 后端（pnpm mock）
MOCK_PORT=5280
MOCK_DB=.data/mock-db.json

# 前端代理到 mock 的地址，默认 http://localhost:5280
MOCK_ORIGIN=
