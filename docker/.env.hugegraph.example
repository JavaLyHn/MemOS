# Copy this file to the repository root as .env and replace placeholders.
# Never commit the resulting .env file.

# LLM used by the MemOS extraction/chat pipeline.
OPENAI_API_KEY=replace-with-llm-api-key
OPENAI_API_BASE=https://api.openai.com/v1
MOS_CHAT_MODEL=gpt-4o-mini

# Use an OpenAI-compatible embedding endpoint from inside the MemOS container.
# Qdrant stores the resulting vectors; it does not generate embeddings.
MOS_EMBEDDER_BACKEND=universal_api
MOS_EMBEDDER_API_BASE=https://api.openai.com/v1
MOS_EMBEDDER_API_KEY=replace-with-embedding-api-key
MOS_EMBEDDER_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Select HugeGraph instead of the default Neo4j backend.
GRAPH_DB_BACKEND=hugegraph
HUGEGRAPH_URL=http://host.docker.internal:8080
HUGEGRAPH_GRAPHSPACE=socgs
HUGEGRAPH_GRAPH=mem_graph
HUGEGRAPH_USER=replace-with-hugegraph-user
HUGEGRAPH_PASSWORD=replace-with-hugegraph-password

# The Compose file overrides these two values to use the qdrant service name.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=memos_hugegraph_vectors

# Required to mount and authenticate the Memmy Memory Runtime compatibility routes.
MEMMY_MEMORY_TOKEN=replace-with-a-random-local-token
MEMMY_MEMORY_SOURCE=memmy-agent
MEMMY_MEMORY_PROFILE_ID=default
MEMMY_MEMORY_USER_ID=replace-with-memos-user-id
# Comma-separated allowlist. Use the workspace hash emitted by memmy-agent.
MEMMY_MEMORY_WORKSPACE_IDS=replace-with-workspace-id

ENABLE_CHAT_API=true
MEMOS_USER_MANAGER_BACKEND=sqlite
